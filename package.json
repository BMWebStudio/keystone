{
  "name": "keystone",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@keystone/web",
    "build": "npm run build --workspace=@keystone/core && npm run build --workspace=@keystone/web",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,css,json,md}\" \"packages/**/*.{ts,tsx,js,jsx,css,json,md}\" \"docs/**/*.{md,mdx}\" \"README.md\"",
    "capture:area": "node scripts/capture.mjs area",
    "capture:fullscreen": "node scripts/capture.mjs fullscreen",
    "capture:window": "node scripts/capture.mjs window",
    "capture:record": "node scripts/capture.mjs record",
    "capture:scroll": "node scripts/capture.mjs scroll",
    "capture:history": "node scripts/capture.mjs history"
  },
  "devDependencies": {
    "prettier": "^3.9.5"
  }
}
